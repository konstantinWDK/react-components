{
  "name": "react-component-kit",
  "version": "0.1.0",
  "description": "A free, open-source accessible UI component library for React \u2014 sister project of astro-component-kit",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./buttons": {
      "types": "./dist/types/components/lib/buttons/index.d.ts",
      "import": "./dist/buttons.js"
    },
    "./feedback": {
      "types": "./dist/types/components/lib/feedback/index.d.ts",
      "import": "./dist/feedback.js"
    },
    "./styles.css": "./dist/styles.css",
    "./global.css": "./dist/global.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-css.mjs && vite build --mode lib && tsc -p tsconfig.build.json && cp src/styles/global.css dist/global.css",
    "build:playground": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "extract-css": "node scripts/extract-css.mjs",
    "check-css": "node scripts/check-css.mjs"
  },
  "keywords": [
    "react",
    "react-components",
    "ui",
    "components",
    "accessible",
    "a11y",
    "glassmorphism"
  ],
  "author": "konstantinwdk <entiplay@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  }
}
