{
  "name": "react-component-kit-ui",
  "version": "0.1.0",
  "description": "Free, open-source, accessible UI component library for React: dark-first glassmorphism design, zero runtime dependencies. Sister project of astro-component-kit.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/components/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/components/index.d.ts",
      "import": "./dist/index.js"
    },
    "./buttons": {
      "types": "./dist/types/components/lib/buttons/index.d.ts",
      "import": "./dist/buttons.js"
    },
    "./feedback": {
      "types": "./dist/types/components/lib/feedback/index.d.ts",
      "import": "./dist/feedback.js"
    },
    "./styles.css": "./dist/styles.css",
    "./global.css": "./dist/global.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "npm run check-css && npm run build:lib",
    "build:lib": "vite build && tsc -p tsconfig.build.json && cp src/styles/global.css dist/global.css",
    "build:site": "next build",
    "preview": "npx serve out",
    "typecheck": "tsc --noEmit",
    "check-css": "node scripts/check-css.mjs",
    "extract-css": "node scripts/extract-css.mjs",
    "pack:check": "npm run build && npm pack --dry-run",
    "prepublishOnly": "npm run typecheck && npm run build",
    "release:patch": "npm version patch -m \"release: v%s\" && npm publish",
    "release:minor": "npm version minor -m \"release: v%s\" && npm publish",
    "release:major": "npm version major -m \"release: v%s\" && npm publish"
  },
  "keywords": [
    "react",
    "react-components",
    "react-component-library",
    "ui",
    "ui-kit",
    "components",
    "accessible",
    "a11y",
    "glassmorphism",
    "dark-mode",
    "design-system",
    "nextjs",
    "typescript"
  ],
  "author": "konstantinwdk <entiplay@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/konstantinWDK/react-components.git"
  },
  "bugs": {
    "url": "https://github.com/konstantinWDK/react-components/issues"
  },
  "homepage": "https://reactcomponents.dev",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.7.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^3.23.0",
    "three": "^0.184.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  }
}
