{
  "name": "react-component-kit-ui",
  "version": "0.1.0",
  "description": "Free, open-source, accessible UI component library for React: dark-first glassmorphism design, zero runtime dependencies. Sister project of astro-component-kit.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/components/index.d.ts",
  "typesVersions": {
    "*": {
      "app": [
        "./dist/types/components/lib/app/index.d.ts"
      ],
      "buttons": [
        "./dist/types/components/lib/buttons/index.d.ts"
      ],
      "cards": [
        "./dist/types/components/lib/cards/index.d.ts"
      ],
      "charts": [
        "./dist/types/components/lib/charts/index.d.ts"
      ],
      "apexcharts": [
        "./dist/types/components/apexcharts.d.ts"
      ],
      "three": [
        "./dist/types/components/three.d.ts"
      ],
      "data": [
        "./dist/types/components/lib/data/index.d.ts"
      ],
      "ecommerce": [
        "./dist/types/components/lib/ecommerce/index.d.ts"
      ],
      "feedback": [
        "./dist/types/components/lib/feedback/index.d.ts"
      ],
      "forms": [
        "./dist/types/components/lib/forms/index.d.ts"
      ],
      "layout": [
        "./dist/types/components/lib/layout/index.d.ts"
      ],
      "navigation": [
        "./dist/types/components/lib/navigation/index.d.ts"
      ],
      "overlays": [
        "./dist/types/components/lib/overlays/index.d.ts"
      ],
      "sections": [
        "./dist/types/components/lib/sections/index.d.ts"
      ],
      "typography": [
        "./dist/types/components/lib/typography/index.d.ts"
      ],
      "templates/ecommerce": [
        "./dist/types/components/lib/templates/ecommerce/index.d.ts"
      ],
      "templates/ecommerce-editorial": [
        "./dist/types/components/lib/templates/ecommerce-editorial/index.d.ts"
      ],
      "templates/saas-hotel": [
        "./dist/types/components/lib/templates/saas-hotel/index.d.ts"
      ],
      "templates/agency": [
        "./dist/types/components/lib/templates/agency/index.d.ts"
      ],
      "templates/portfolio": [
        "./dist/types/components/lib/templates/portfolio/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types/components/index.d.ts",
      "import": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/types/components/lib/app/index.d.ts",
      "import": "./dist/app.js"
    },
    "./buttons": {
      "types": "./dist/types/components/lib/buttons/index.d.ts",
      "import": "./dist/buttons.js"
    },
    "./cards": {
      "types": "./dist/types/components/lib/cards/index.d.ts",
      "import": "./dist/cards.js"
    },
    "./charts": {
      "types": "./dist/types/components/lib/charts/index.d.ts",
      "import": "./dist/charts.js"
    },
    "./apexcharts": {
      "types": "./dist/types/components/apexcharts.d.ts",
      "import": "./dist/apexcharts.js"
    },
    "./three": {
      "types": "./dist/types/components/three.d.ts",
      "import": "./dist/three.js"
    },
    "./data": {
      "types": "./dist/types/components/lib/data/index.d.ts",
      "import": "./dist/data.js"
    },
    "./ecommerce": {
      "types": "./dist/types/components/lib/ecommerce/index.d.ts",
      "import": "./dist/ecommerce.js"
    },
    "./feedback": {
      "types": "./dist/types/components/lib/feedback/index.d.ts",
      "import": "./dist/feedback.js"
    },
    "./forms": {
      "types": "./dist/types/components/lib/forms/index.d.ts",
      "import": "./dist/forms.js"
    },
    "./layout": {
      "types": "./dist/types/components/lib/layout/index.d.ts",
      "import": "./dist/layout.js"
    },
    "./navigation": {
      "types": "./dist/types/components/lib/navigation/index.d.ts",
      "import": "./dist/navigation.js"
    },
    "./overlays": {
      "types": "./dist/types/components/lib/overlays/index.d.ts",
      "import": "./dist/overlays.js"
    },
    "./sections": {
      "types": "./dist/types/components/lib/sections/index.d.ts",
      "import": "./dist/sections.js"
    },
    "./typography": {
      "types": "./dist/types/components/lib/typography/index.d.ts",
      "import": "./dist/typography.js"
    },
    "./templates/ecommerce": {
      "types": "./dist/types/components/lib/templates/ecommerce/index.d.ts",
      "import": "./dist/templates/ecommerce.js"
    },
    "./templates/ecommerce-editorial": {
      "types": "./dist/types/components/lib/templates/ecommerce-editorial/index.d.ts",
      "import": "./dist/templates/ecommerce-editorial.js"
    },
    "./templates/saas-hotel": {
      "types": "./dist/types/components/lib/templates/saas-hotel/index.d.ts",
      "import": "./dist/templates/saas-hotel.js"
    },
    "./templates/agency": {
      "types": "./dist/types/components/lib/templates/agency/index.d.ts",
      "import": "./dist/templates/agency.js"
    },
    "./templates/portfolio": {
      "types": "./dist/types/components/lib/templates/portfolio/index.d.ts",
      "import": "./dist/templates/portfolio.js"
    },
    "./styles.css": "./dist/styles.css",
    "./global.css": "./dist/global.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "npm run check-css && npm run build:lib",
    "build:lib": "vite build && tsc -p tsconfig.build.json && cp src/styles/global.css dist/global.css",
    "build:site": "next build",
    "preview": "npx serve out",
    "typecheck": "tsc --noEmit",
    "check-css": "node scripts/check-css.mjs",
    "extract-css": "node scripts/extract-css.mjs",
    "pack:check": "npm run build && npm pack --dry-run",
    "prepublishOnly": "npm run typecheck && npm run build",
    "release:patch": "npm version patch -m \"release: v%s\" && npm publish",
    "release:minor": "npm version minor -m \"release: v%s\" && npm publish",
    "release:major": "npm version major -m \"release: v%s\" && npm publish",
    "mcp:build": "esbuild mcp/server.ts --bundle --platform=node --format=esm --target=node20 --outfile=mcp-dist/server.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\" --log-level=warning",
    "mcp:dev": "tsx mcp/server.ts",
    "mcp:start": "node mcp-dist/server.mjs",
    "mcp:check": "tsc -p tsconfig.mcp.json"
  },
  "keywords": [
    "a11y",
    "accessible",
    "charts",
    "components",
    "dark-mode",
    "dashboard",
    "design-system",
    "ecommerce",
    "glassmorphism",
    "landing-page",
    "nextjs",
    "react",
    "react-component-library",
    "react-components",
    "sections",
    "templates",
    "typescript",
    "ui",
    "ui-kit"
  ],
  "author": "konstantinwdk <entiplay@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/konstantinWDK/react-components.git"
  },
  "bugs": {
    "url": "https://github.com/konstantinWDK/react-components/issues"
  },
  "homepage": "https://reactcomponents.dev",
  "peerDependencies": {
    "apexcharts": ">=3.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "three": ">=0.160.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "20.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.7.0",
    "apexcharts": "^3.54.1",
    "next": "^15.5.29",
    "postcss": "^8.5.32",
    "postcss-selector-parser": "^7.1.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^3.23.0",
    "three": "^0.184.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "zod": "^3.25.76"
  },
  "peerDependenciesMeta": {
    "apexcharts": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  }
}
